<Application x:Class="CpqSystemTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf">
    <Application.Resources>
        <!-- 富日志行模板：时间戳 + 小图标（check→绿色矢量勾，其他→彩色 emoji）+ 文本。
             彩色 emoji 必须用 emoji:TextBlock（Emoji.Wpf）：它以 DrawingImage 渲染原色图形。
             不可用普通 TextBlock + FontFamily="Segoe UI Emoji" —— WPF 文本路径会把 emoji
             当普通字形用 Foreground 着色，结果是纯黑单色（已实测踩坑）。 -->
        <DataTemplate x:Key="LogLineTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <!-- 完全复刻 office-ui-prototype：emoji:TextBlock + ColorBlend=False 渲染原色图形。
                         check → 交下方绿色矢量勾（哨兵值"定位替换"）；
                         ▪ → 交下方灰色 Ellipse（▪ 是几何符号非 emoji，若在此渲染会是黑方块叠加灰点）。 -->
                    <emoji:TextBlock FontSize="14"
                                     VerticalAlignment="Center"
                                     Text="{Binding Icon, Mode=OneWay}"
                                     ColorBlend="False">
                        <emoji:TextBlock.Style>
                            <Style TargetType="{x:Type emoji:TextBlock}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="check">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Icon}" Value="▪">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </emoji:TextBlock.Style>
                    </emoji:TextBlock>
                    <Path Data="M1,5 L5,9 L14,1"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="check">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <!-- 默认灰色圆点：当 Icon=="•" 时显示 -->
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource SubTextBrush}"
                             VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="▪">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
                <TextBlock FontFamily="Consolas, 'Microsoft YaHei UI'" FontSize="11"
                           Margin="6,0,0,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource SubTextBrush}"
                           TextWrapping="Wrap">
                    <Run Text="{Binding Timestamp, Mode=OneWay}"/>
                    <Run Text="  "/>
                    <Run Text="{Binding Text, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Application.Resources>
</Application>
