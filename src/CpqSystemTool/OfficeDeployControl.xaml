<UserControl x:Class="CpqSystemTool.OfficeDeployControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             x:Name="_root">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- 底部留白 8→3（压缩 5px）：Office 部署页本控件 LogBox 被 ExternalLogSink 隐藏，
             按钮行下方这段留白是“开始安装”按钮下一行的空白；压 5px 让页级日志框 8 行在默认窗口完整显示 -->
        <StackPanel Margin="0,0,0,3">
            <!-- 标题 + 操作步骤提示（与下方组件网格间距 8） -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                <!-- 彩色 emoji 图标：Emoji.Wpf TextBlock 原色渲染（与激活页 🎯/📋 同一方案），
                     字号与标题 13 对齐，右间距 6 -->
                <emoji:TextBlock Text="📦" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"
                                 Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="TitleText"
                           Text="选择要安装 / 修改的组件"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"/>
                <Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap">
                        <Run Text="操作步骤："/>
                        <Run Text="1. 选择 Office 版本 → 2. 勾选组件图标 → 3. 设置架构/语言 → 4. 点击开始安装"/>
                    </TextBlock>
                </Border>
            </StackPanel>

            <!-- 组件网格（与上方标题块间距 8，下方与选项行间距 8） -->
            <ItemsControl x:Name="ComponentsList" ItemsSource="{Binding Components, ElementName=_root}" Margin="0,8,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 10 列 × 1 行：每格自动均分 1/10 宽度，默认窗口下正好铺满一行、不折行 -->
                        <UniformGrid Columns="10" Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{DynamicResource ComponentToggleStyle}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <!-- 不写死宽度：由 ComponentToggleStyle 的 ContentPresenter(Stretch) 随单元格自适应 -->
                            <StackPanel>
                                <Image Source="{Binding IconPath}"
                                       Height="44" Width="44"
                                       Stretch="Uniform"
                                       Margin="0,0,0,4"/>
                                <!-- 前景色由 ComponentToggleStyle 的 TextElement.Foreground 继承（选中时自动变深墨色） -->
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 选项行 + 提醒行（方案1+精确测量：标签抽独立列 col0/2/4/6，combo 各占固定宽列 col1/3/5/7，
                 末列 col8 = * 弹性余量；第 1/2 行放两条提醒，各占独立 Row，互不遮挡）。
                 安装位置提醒 (LocationHintText) 与「安装位置：」标签 (LabelLocation, col6) 的左缘
                 由后台 LayoutUpdatedCalibrate() 用 WPF Transform 坐标变换精确测量对齐（确定性、不重排、
                 不写死进布局）；XAML 里 Margin.Left=562 仅作首帧静态兜底，渲染一次后即被测量值取代。 -->
            <Grid x:Name="OptionGrid" Margin="0,8,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- col0 版本：标签 -->
                    <ColumnDefinition Width="300"/>    <!-- col1 EditionCombo -->
                    <ColumnDefinition Width="Auto"/>   <!-- col2 架构：标签 -->
                    <ColumnDefinition Width="65"/>     <!-- col3 ArchCombo -->
                    <ColumnDefinition Width="Auto"/>   <!-- col4 语言：标签 -->
                    <ColumnDefinition Width="95"/>     <!-- col5 LangCombo -->
                    <ColumnDefinition Width="Auto"/>   <!-- col6 安装位置：标签 -->
                    <ColumnDefinition Width="130"/>    <!-- col7 LocationCombo -->
                    <ColumnDefinition Width="*"/>      <!-- col8 弹性余量 -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Row0 选项 -->
                    <RowDefinition Height="22"/>    <!-- Row1 ARM 提示 + 安装位置提醒（固定高 22，文本 10.5pt 上下留白，行内竖向居中） -->
                </Grid.RowDefinitions>

                <!-- 第 0 行：版本 / 架构 / 语言 / 安装位置（标签与 combo 各占独立列） -->
                <TextBlock x:Name="LabelLocation" Grid.Row="0" Grid.Column="6" Text="安装位置：" FontSize="11"
                           Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="版本：" FontSize="11"
                           Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="EditionCombo"
                          Grid.Row="0" Grid.Column="1"
                          MinWidth="300" Height="28" FontSize="11"
                          VerticalContentAlignment="Center"
                          HorizontalContentAlignment="Left"
                          Margin="0,0,12,0">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="架构：" FontSize="11"
                           Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="ArchCombo"
                          Grid.Row="0" Grid.Column="3"
                          SelectedItem="{Binding SelectedArchitecture, ElementName=_root}"
                          MinWidth="65" Height="28" FontSize="11"
                          VerticalContentAlignment="Center"
                          HorizontalContentAlignment="Center"
                          Margin="0,0,12,0">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="语言：" FontSize="11"
                           Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <!-- 语言下拉改为中文显示（Items 由后台填充：Content=中文名，Tag=ODT 区域码） -->
                <ComboBox x:Name="LangCombo"
                          Grid.Row="0" Grid.Column="5"
                          MinWidth="95" Height="28" FontSize="11"
                          VerticalContentAlignment="Center"
                          HorizontalContentAlignment="Center"
                          Margin="0,0,12,0">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <ComboBox x:Name="LocationCombo"
                          Grid.Row="0" Grid.Column="7"
                          MinWidth="130" Height="28" FontSize="11"
                          VerticalContentAlignment="Center"
                          HorizontalContentAlignment="Left"
                          Margin="0,0,12,0">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <Button x:Name="OpenXmlBtn"
                        Grid.Row="0" Grid.Column="8"
                        Background="{DynamicResource SecondaryButtonBgBrush}"
                        Foreground="{DynamicResource SecondaryButtonFgBrush}"
                        BorderBrush="{DynamicResource BorderBrushKey}"
                        BorderThickness="1"
                        MinWidth="90" Height="28" FontSize="11"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Left">
                    <Button.Content>
                        <emoji:TextBlock Text="📄 打开 XML" FontSize="11" VerticalAlignment="Center"/>
                    </Button.Content>
                </Button>

                <!-- 第 1 行：架构限制提醒 + 安装位置提醒（同一行、高度方向对齐）。
                     水平 StackPanel 承载两条提醒，整行在 Row1 内 VerticalAlignment=Center；
                     无额外上/下 Margin（避免偏上），两条 TextBlock 自然同高同行。
                     安装位置提醒的左缘由后台 LayoutUpdatedCalibrate() 一次性 Loaded 校准
                     （精确到「安装位置」标签左缘，只在首帧执行一次、不做每帧 RenderTransform → 不闪）。 -->
                <StackPanel x:Name="HintRowPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="9"
                            Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                    <TextBlock x:Name="ArmHintText"
                               Text="ARM 设备仅支持 64 位，Win11 设备仅支持 64 位 Office，请选 64 位。"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="LocationHintText"
                               Text="安装到其他盘需管理员权限，选择后可自动请求"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ODT 路径行（标签 + 路径框 + 浏览/打开文件夹） -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <TextBlock Text="ODT 路径：" FontSize="11"
                           Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="SetupPathBox"
                         Width="275" Height="28" FontSize="11"
                         Background="{DynamicResource BgBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrushKey}"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         Margin="0,0,6,0"/>
                <Button x:Name="BrowseBtn" Content="浏览"
                        Background="{DynamicResource SecondaryButtonBgBrush}"
                        Foreground="{DynamicResource SecondaryButtonFgBrush}"
                        BorderBrush="{DynamicResource BorderBrushKey}"
                        BorderThickness="1"
                        MinWidth="84" Padding="10,4" Height="28" FontSize="11"
                        Margin="0,0,4,0"/>
                <Button x:Name="OpenFolderBtn" Content="打开文件夹"
                        Background="{DynamicResource SecondaryButtonBgBrush}"
                        Foreground="{DynamicResource SecondaryButtonFgBrush}"
                        BorderBrush="{DynamicResource BorderBrushKey}"
                        BorderThickness="1"
                        MinWidth="84" Padding="10,4" Height="28" FontSize="11"/>
                <!-- 说明移到 ODT 行「打开文件夹」之后，同一行显示 -->
                <TextBlock x:Name="HintText"
                           Text="勾选组件后点击「开始安装」，ODT 会自动下载 setup.exe 并生成 config.xml 执行安装。"
                           FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 安装位置已并入上方选项行（语言之后），原独立行移除 -->

            <!-- 更新通道行（A 方案：订阅版真·切通道 + 永久版重部署切版本，入口放 ODT 路径行下方） -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <!-- 订阅版 M365 原地切更新通道（不重装，C2R 更新器下次拉包对齐目标通道） -->
                <Button x:Name="SwitchChannelBtn"
                        Background="{DynamicResource SecondaryButtonBgBrush}"
                        Foreground="{DynamicResource SecondaryButtonFgBrush}"
                        BorderBrush="{DynamicResource BorderBrushKey}"
                        BorderThickness="1"
                        MinWidth="120" Padding="10,4" Height="28" FontSize="11"
                        Margin="0,0,8,0"
                        ToolTip="不重装，仅更改已装 Office 的更新通道（升级/降级到目标通道的当前构建）">
                    <Button.Content>
                        <emoji:TextBlock Text="🔄 切换更新通道" FontSize="11" VerticalAlignment="Center"/>
                    </Button.Content>
                </Button>
                <TextBlock Text="更新通道：" FontSize="11"
                           Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <!-- 当前通道/版本状态（后台探测 TryGetInstalledSuite 后填入） -->
                <TextBlock x:Name="CurChannelText"
                           Text="未检测到已装 Office"
                           FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <!-- 永久版（LTSC/2019）切大版本：重新部署（会重装，保留激活） -->
                <Button x:Name="SwitchEditionBtn"
                        Background="{DynamicResource SecondaryButtonBgBrush}"
                        Foreground="{DynamicResource SecondaryButtonFgBrush}"
                        BorderBrush="{DynamicResource BorderBrushKey}"
                        BorderThickness="1"
                        MinWidth="150" Padding="10,4" Height="28" FontSize="11"
                        Margin="0,0,8,0"
                        ToolTip="切换到 2019/2021/2024 等不同版本（重新部署，会重装 Office 但保留激活）">
                    <Button.Content>
                        <emoji:TextBlock Text="🔃 切换到其他版本" FontSize="11" VerticalAlignment="Center"/>
                    </Button.Content>
                </Button>
                <TextBlock x:Name="ChannelHintText"
                           Text="订阅版可原地切通道；永久版(LTSC/2019)需重新部署换版本。"
                           FontSize="10.5" Foreground="{DynamicResource SubTextBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 进度条 -->
            <ProgressBar x:Name="ProgressBar"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue, ElementName=_root, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminateProgress, ElementName=_root, Mode=OneWay}"
                         Height="4" Margin="0,5,0,2"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource BorderBrushKey}"/>

            <!-- 开始按钮 + 状态 + 卸载按钮 + 运行时间（同在一行，时间靠右） -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                <Button x:Name="InstallBtn"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource PrimaryButtonFgBrush}"
                        MinWidth="120" Height="32" FontSize="12" FontWeight="SemiBold"
                        Margin="0,0,8,0">
                    <Button.Content>
                        <emoji:TextBlock Text="🚀 开始安装" FontSize="12" VerticalAlignment="Center"/>
                    </Button.Content>
                </Button>
                <Button x:Name="UninstallBtn"
                        Background="{DynamicResource SecondaryButtonBgBrush}"
                        Foreground="{DynamicResource SecondaryButtonFgBrush}"
                        BorderBrush="{DynamicResource BorderBrushKey}"
                        BorderThickness="1"
                        MinWidth="140" Height="32" FontSize="12"
                        Margin="0,0,12,0"
                        ToolTip="强力卸载 Office（C2R）全家桶：默认卸载 Office 全量；若勾选，亦会一并移除 OneDrive / Teams（仅当本机已安装且你勾选时）。">
                    <Button.Content>
                        <emoji:TextBlock Text="🗑 强力卸载 Office" FontSize="12" VerticalAlignment="Center"/>
                    </Button.Content>
                </Button>
                <TextBlock x:Name="StatusText"
                           Text="{Binding StatusMessage, ElementName=_root, Mode=OneWay}"
                           FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center"/>
                <!-- 运行时间：安装阶段显示，紧贴在状态文字右侧 -->
                <TextBlock x:Name="ElapsedText"
                           Text="{Binding ElapsedTime, ElementName=_root, Mode=OneWay}"
                           FontSize="10" Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Visibility="{Binding ElapsedVisibility, ElementName=_root, Mode=OneWay}"/>
            </StackPanel>

            <!-- 日志框：时间戳 + 小图标（合并前 office-ui-prototype 的富日志渲染，本次还原） -->
            <Border x:Name="LogBox"
                    Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource BorderBrushKey}"
                    BorderThickness="1"
                    CornerRadius="6" Padding="6" Margin="0,2,0,0">
                <ScrollViewer x:Name="LogScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MinHeight="140" MaxHeight="260">
                    <ItemsControl ItemsSource="{Binding InstallLog, ElementName=_root, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                    <!-- 左侧小图标：Icon=="check" 显示绿色矢量对勾，否则显示彩色 emoji -->
                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                        <!-- 完全复刻 office-ui-prototype：emoji:TextBlock + ColorBlend=False 渲染原色图形。
                                             check → 绿色矢量勾；▪ → 灰点 Ellipse（非 emoji，避免黑方块叠加） -->
                                        <emoji:TextBlock FontSize="14"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding Icon, Mode=OneWay}"
                                                         ColorBlend="False">
                                            <emoji:TextBlock.Style>
                                                <Style TargetType="{x:Type emoji:TextBlock}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="check">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Icon}" Value="▪">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </emoji:TextBlock.Style>
                                        </emoji:TextBlock>
                                        <Path Data="M1,5 L5,9 L14,1"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="check">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                    <!-- 时间戳 + 文本 -->
                                    <TextBlock FontFamily="Consolas, 'Microsoft YaHei UI'" FontSize="11"
                                               Margin="6,0,0,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               TextWrapping="Wrap">
                                        <Run Text="{Binding Timestamp, Mode=OneWay}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Text, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
