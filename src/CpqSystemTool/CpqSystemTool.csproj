<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>系统清理与优化工具</AssemblyName>
    <RootNamespace>CpqSystemTool</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>NU1603;NU1510</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationIcon>brush.ico</ApplicationIcon>
    <!-- 程序集元数据：文件属性中显示的中文产品信息 -->
    <AssemblyTitle>系统清理与优化工具</AssemblyTitle>
    <AssemblyProduct>系统清理与优化工具</AssemblyProduct>
    <AssemblyDescription>面向 Windows 10/11 的一体化系统清理、优化与维护工具</AssemblyDescription>
    <AssemblyCopyright>Copyright © 2026</AssemblyCopyright>
    <AssemblyVersion>1.0.23.0</AssemblyVersion>
    <FileVersion>1.0.23.0</FileVersion>
    <InformationalVersion>1.0.23.0</InformationalVersion>
    <!-- 显式 x64：Windows 10/11 无 32 位版本，且 64 位进程可加载 64 位 WebView2 Runtime -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- rollForward=Minor：允许使用更新的补丁版本（如 10.0.11 满足 10.0.0 要求） -->
    <RollForward>Minor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.2045.28, 1.0.2045.28]" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <!-- 中文控制台输出解码（cscript/slmgr/ospp 在中文 Windows 输出 GBK/CP936）：
         Exec.cs 静态构造 RegisterProvider(CodePagesEncodingProvider.Instance) + GetEncoding("GBK") 需本包 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
    <!-- 彩色 emoji 渲染（Emoji.Wpf TextBlock：普通文字走前景色画笔，emoji 字形自动以原色图形渲染，
         浅色/深色主题均适用）；与 office-ui-prototype 同一方案（0.3.4，本地 NuGet 缓存已验证） -->
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <!-- 多线程分块下载器（bezzad.Downloader，v5.x 兼容 .NET 10，OTP 同款）：
         替换原 Downloader.cs 单线程串行实现，ChunkCount=8 并行分块，提速 3-8 倍；
         零外部依赖（仅可选 Microsoft.Extensions.Logging.Abstractions），MIT 许可。
         浮动范围 [5.9,6.0)：5.x 内自动吃到 patch/minor 更新，6.0 大版本自动拦下（防 breaking change）。 -->
    <PackageReference Include="Downloader" Version="[5.9,6.0)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="brush.ico" />
    <Resource Include="brush.png" />
    <Resource Include="background.png" />
    <Resource Include="background-light.png" />
    <Resource Include="Icons\*.png" />
    <EmbeddedResource Include="Resources\Skus\**\*.xrm-ms" />
    <!-- About 页更新日志单一事实来源：嵌入仓库根 CHANGELOG.md，运行时解析渲染，避免与硬编码文本脱节 -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

  <!--
    ===========================================================================
    源码披露包（v1.19 起不再内嵌 src.zip）
    ===========================================================================
    旧方案把 src.zip 作为 EmbeddedResource 嵌进 exe，导致：
      1) exe 体积增加约 960KB；
      2) src.zip 是历史快照，MSBuild 不会随源码变化自动重打包，导出的是过时代码。
    新方案：文件夹发布（PublishSingleFile != true）时，把「源码目录」原样复制到
    输出目录的 src/CpqSystemTool，用户点击「导出源码」时由 MainWindow.Config.cs
    直接复制这些真实文件。单文件发布不复制。
    注：单文件发布的「导出源码」由下方 GenerateSourcePackage 生成的内嵌包承担，不受本目标影响。
    ===========================================================================
  -->
  <Target Name="CopySourceDisclosure" AfterTargets="Publish">
    <PropertyGroup>
      <_SrcDisclosureSrc>$(MSBuildProjectDirectory)\..\..\src\CpqSystemTool</_SrcDisclosureSrc>
      <_SrcDisclosureReadme>$(MSBuildProjectDirectory)\..\..\README.md</_SrcDisclosureReadme>
    </PropertyGroup>
    <ItemGroup>
      <_SrcDisclosureFiles Include="$(_SrcDisclosureSrc)\**\*"
                           Exclude="$(_SrcDisclosureSrc)\bin\**;$(_SrcDisclosureSrc)\obj\**;$(_SrcDisclosureSrc)\.vs\**;$(_SrcDisclosureSrc)\.git\**;$(_SrcDisclosureSrc)\packages\**;**\*.bak*;**\*.tmp;**\*.log;**\*.user;**\*.suo" />
    </ItemGroup>
    <Copy SourceFiles="@(_SrcDisclosureFiles)"
          DestinationFiles="@(_SrcDisclosureFiles->'$(PublishDir)src\CpqSystemTool\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_SrcDisclosureSrc)') And '$(PublishSingleFile)' != 'true' And '$(PublishDir)' != ''" />
    <Copy SourceFiles="$(_SrcDisclosureReadme)"
          DestinationFiles="$(PublishDir)src\CpqSystemTool\README.md"
          Condition="Exists('$(_SrcDisclosureReadme)') And '$(PublishSingleFile)' != 'true' And '$(PublishDir)' != ''" />
  </Target>

  <!--
    ===========================================================================
    源码披露包：构建期自动生成并内嵌（v1.19 起，内嵌体积约 0.82MB）
    ===========================================================================
    为什么在 BeforeBuild 生成：
      MSBuild 的 EmbeddedResource 不会随源码变化自动重打包，旧方案手工维护 src.zip
      导致 exe 里内嵌的是历史快照、导出的是过时代码。改为 BeforeBuild 每次构建都从
      当前源码重新打包，内嵌内容永远与本次构建一致。

    为什么排除两张背景图（background.png / background-light.png，合计 2.21MB，占包 73%）：
      它们本来就以 <Resource> 形式嵌在程序集内（窗口背景即读它），在源码包里再存一份
      是重复。导出时由 MainWindow.Config.cs 的 CpqExtractBackgroundsFromAssembly 用
      Application.GetResourceStream 从运行中的程序集取回，导出结果依然完整可编译。

    为什么排除 Microsoft.Web.WebView2.Core.dll：NuGet 依赖，不属于源码披露范围。
    ===========================================================================
  -->
  <Target Name="GenerateSourcePackage" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_SrcPkgRoot>$(MSBuildProjectDirectory)\..\..</_SrcPkgRoot>
      <_SrcPkgSrc>$(_SrcPkgRoot)\src\CpqSystemTool</_SrcPkgSrc>
      <_SrcPkgShell>$(_SrcPkgRoot)\tools\cpq-shell</_SrcPkgShell>
      <_SrcPkgStage>$(IntermediateOutputPath)srcpkg\</_SrcPkgStage>
      <_SrcPkgZip>$(IntermediateOutputPath)CpqSystemTool.srcpkg.zip</_SrcPkgZip>
    </PropertyGroup>

    <ItemGroup>
      <_SrcPkgFiles Include="$(_SrcPkgSrc)\**\*"
                    Exclude="$(_SrcPkgSrc)\bin\**;$(_SrcPkgSrc)\obj\**;$(_SrcPkgSrc)\.vs\**;$(_SrcPkgSrc)\.git\**;$(_SrcPkgSrc)\packages\**;$(_SrcPkgSrc)\background.png;$(_SrcPkgSrc)\background-light.png;$(_SrcPkgSrc)\Microsoft.Web.WebView2.Core.dll;**\*.bak*;**\*.tmp;**\*.log;**\*.user;**\*.suo;$(_SrcPkgSrc)\Icons\**;$(_SrcPkgSrc)\src.zip;$(_SrcPkgSrc)\Resources\Skus\**;$(_SrcPkgSrc)\src\**;$(_SrcPkgSrc)\src\publish\**;**\*.exe;**\*.dll;**\*.pdb;*.png-opt;cmp_*.png;preview_*.png;background-light.jpg-*" />
    </ItemGroup>

    <RemoveDir Directories="$(_SrcPkgStage)" Condition="Exists('$(_SrcPkgStage)')" />
    <Copy SourceFiles="@(_SrcPkgFiles)"
          DestinationFiles="@(_SrcPkgFiles->'$(_SrcPkgStage)src\CpqSystemTool\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false"
          Condition="Exists('$(_SrcPkgSrc)')" />
    <!-- 智能外壳源码（v1.23 修订）：tools\cpq-shell 一并入包，「导出源码」= 完整源码披露 -->
    <ItemGroup>
      <_SrcPkgShellFiles Include="$(_SrcPkgShell)\**\*" Exclude="$(_SrcPkgShell)\bin\**;**\*.exe;**\*.dll;**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_SrcPkgShellFiles)"
          DestinationFiles="@(_SrcPkgShellFiles->'$(_SrcPkgStage)tools\cpq-shell\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false"
          Condition="Exists('$(_SrcPkgShell)')" />
    <Copy SourceFiles="$(_SrcPkgRoot)\README.md"
          DestinationFiles="$(_SrcPkgStage)README.md"
          Condition="Exists('$(_SrcPkgRoot)\README.md')" />

    <ZipDirectory SourceDirectory="$(_SrcPkgStage)"
                  DestinationFile="$(_SrcPkgZip)"
                  Overwrite="true"
                  Condition="Exists('$(_SrcPkgStage)')" />

    <ItemGroup Condition="Exists('$(_SrcPkgZip)')">
      <EmbeddedResource Include="$(_SrcPkgZip)">
        <LogicalName>CpqSystemTool.srcpkg.zip</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!--
    ===========================================================================
    清理 repo 根目录旧运行时宿主残留（v1.20 新增）
    ===========================================================================
    问题：历史自包含发布会把 hostfxr.dll / coreclr.dll / System.Private.CoreLib.dll 等
      旧版运行时 DLL 留在 repo 根目录。这些文件与单文件 bundle 同目录时，.NET 宿主会
      优先使用旧版 hostfxr 解析 runtimeconfig.json，而非系统安装的 .NET 运行时，
      导致 rollForward=Minor 等配置不生效，应用报"必须安装 .NET X.Y.0"。
    解决：在每次 Publish 完成后自动删除这些干扰文件。
    安全：.gitignore:53 已有 *.dll 规则，所有遗留 DLL 从未被 git 追踪，可安全删除。
  -->
  <Target Name="CleanLegacyRuntimeHostArtifacts"
          AfterTargets="Publish"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..')">
    <PropertyGroup>
      <_RepoRoot>$(MSBuildThisFileDirectory)..\..</_RepoRoot>
    </PropertyGroup>
    <ItemGroup>
      <_LegacyHostDlls Include="$(_RepoRoot)\hostfxr.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\hostpolicy.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\coreclr.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\clretwrc.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\clrgc.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\clrgcexp.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\clrjit.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\mscorrc.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\mscordaccore.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\mscordbi.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\vcruntime140_cor3.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\System.Private.CoreLib.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\mscorlib.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\msquic.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\netstandard.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\D3DCompiler_47_cor3.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\DirectWriteForwarder.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\PenImc_cor3.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\PresentationNative_cor3.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\wpfgfx_cor3.dll" />
      <!-- NuGet restore 产生的临时依赖 DLL（单文件 bundle 已将依赖嵌入 exe，根目录无需保留） -->
      <_LegacyHostDlls Include="$(_RepoRoot)\Microsoft.Web.WebView2.Core.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\Microsoft.Web.WebView2.WinForms.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\Microsoft.Web.WebView2.Wpf.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\WebView2Loader.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\System.Management.dll" />
      <_LegacyHostDlls Include="$(_RepoRoot)\System.ServiceProcess.ServiceController.dll" />
      <_LegacyExtras Include="$(_RepoRoot)\temp_runtimeconfig.json" />
      <_LegacyExtras Include="$(MSBuildProjectDirectory)\..\..\tools\fix_runtimeconfig.py" />
      <_LegacyExtras Include="$(_RepoRoot)\系统清理与优化工具.dll" />
      <_LegacyExtras Include="$(_RepoRoot)\系统清理与优化工具.pdb" />
    </ItemGroup>
    <Delete Files="@(_LegacyHostDlls);@(_LegacyExtras)"
            ContinueOnError="true" />
    <Message Importance="low"
             Text="[Cleanup] 已清理旧运行时宿主残留（共 %(_LegacyHostDlls.Identity->Count()) + %(_LegacyExtras.Identity->Count()) 个文件）" />
  </Target>

</Project>

