<Application x:Class="CpqSystemTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- StartupUri 已移除：主窗口改由 App.xaml.cs 的 OnStartup 手动创建并显示，
         这样「挂载 DispatcherUnhandledException」一定早于主窗口构造，构造函数抛出的异常也能被捕获。 -->
    <!-- 资源全部由代码动态构建（MainWindow.xaml Window.Resources + Theme.cs），
         此文件不再定义任何静态样式，避免硬编码深色 + StaticResource 不跟随主题的问题。 -->
</Application>
