bin/
obj/
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# Logs
*.log
build_err*.txt
build_out*.txt
crash.log

# Backups / temp
*.bak
*.bak.*
*.bak_*
# add_site_version.py 生成的带时间戳备份（download.html.bak-<时间戳>）
*.bak-*
# 临时沙箱测试目录
_sandbox_test/
nul

# User runtime data / config
Config/
custom_software.json
autosave.json
*.autosave

# Tool internals
.workbuddy/
.cleanup_trash/
.archive_reports/
# 本地完成标记（构建/脚本落点，非源码）
_done.txt
backup/
# 临时 diff 对比文件，不应提交
cr_tmp/
# 临时核对目录（GitHub 勘误等工作产物）
.tmp_check/
# 已废弃旧脚本目录（已从 GitHub 树移除，本地残留防误提交）
tools/_deprecated/

# 3rd-party deps
node_modules/
tools/probes/node_modules/
tools/probes/.tools/
# NuGet 还原产物（WebView2 等），不应提交
runtimes/
# Edge 离线安装包（201M），通过 Release 分发，不进仓库
tools/edge_offline/

# Large binaries / release artifacts (publish as GitHub Release instead)
*.exe
*.exe.config
# NuGet 还原的运行时 DLL（WebView2 等），不应提交
*.dll
*.msi
*.zip
*.psd
*.pdb

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Non-project memory dump
MEMORY_full.md

# Local investigation / deployment artifacts (not part of the project, do not commit)
# 用 ASCII 日期后缀锚定，规避中文文件名 Unicode 归一化导致 .gitignore 不匹配
*_2026-08-12.md
pnputil_*.txt
code_review_*.md
site-dist/

# 本地 exe 备份目录（发布修复时留档，不入库）
.exe-backup-*/

# 发布产物目录（dotnet publish 输出，含 exe/dll/pdb/runtimes 与源码副本，不入库）
src/publish/

# 本地产物 / 调查文档（不入 git）
ocr_*.txt
OCR审查工作流.md
代码审核-优化建议.md
src/CpqSystemTool/publish_out*.txt
src/CpqSystemTool/publish_err*.txt
src/CpqSystemTool/_publish.out
src/CpqSystemTool/_winrt_probe.cs.txt
_site_*.html

# 根目录 publish 输出（-o publish 单文件/文件夹布局，不入库；src/publish 旧路径已忽略）
publish/
publish2/
# 临时哈希标记文件
tools/_new_sha.txt
