# Build output
bin/
obj/
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# Logs
*.log
build_err*.txt
build_out*.txt
crash.log

# Backups / temp
*.bak
*.bak.*
# add_site_version.py 生成的带时间戳备份（download.html.bak-<时间戳>）
*.bak-*
# 临时沙箱测试目录
_sandbox_test/
nul

# User runtime data / config
Config/
custom_software.json
autosave.json
*.autosave

# Tool internals
.workbuddy/
.cleanup_trash/
.archive_reports/
backup/
# 临时 diff 对比文件，不应提交
cr_tmp/
# 已废弃旧脚本目录（已从 GitHub 树移除，本地残留防误提交）
tools/_deprecated/

# 3rd-party deps
node_modules/
tools/probes/node_modules/
# NuGet 还原产物（WebView2 等），不应提交
runtimes/
# Edge 离线安装包（201M），通过 Release 分发，不进仓库
tools/edge_offline/

# Large binaries / release artifacts (publish as GitHub Release instead)
*.exe
*.exe.config
# NuGet 还原的运行时 DLL（WebView2 等），不应提交
*.dll
*.msi
*.zip
# 源码导出包：随源码提交，构建必需（否则克隆后报 CS1566）
!src/CpqSystemTool/src.zip
*.psd
*.pdb

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Non-project memory dump
MEMORY_full.md

# Local investigation / deployment artifacts (not part of the project, do not commit)
# 用 ASCII 日期后缀锚定，规避中文文件名 Unicode 归一化导致 .gitignore 不匹配
*_2026-08-12.md
pnputil_*.txt
code_review_*.md
site-dist/
